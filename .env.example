# Environment Configuration for rnaseq-tpm-fpkm-converter
# Copy this file to .env and update the values

# Required: Secret key for HMAC-SHA256 audit trail signing
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=your-secure-random-key-here

# LLM provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock
